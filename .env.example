URL_SHORTENER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/url_shortener
URL_SHORTENER_REDIS_URL=redis://localhost:6379/0
URL_SHORTENER_PUBLIC_BASE_URL=http://127.0.0.1:8000
URL_SHORTENER_LINK_CACHE_TTL_SECONDS=3600
URL_SHORTENER_DB_POOL_SIZE=10
URL_SHORTENER_DB_MAX_OVERFLOW=20
URL_SHORTENER_DB_POOL_TIMEOUT_SECONDS=5
URL_SHORTENER_DB_CONNECT_TIMEOUT_SECONDS=5
URL_SHORTENER_DB_READINESS_TIMEOUT_SECONDS=2
URL_SHORTENER_REDIS_MAX_CONNECTIONS=50
URL_SHORTENER_REDIS_CONNECT_TIMEOUT_SECONDS=2
URL_SHORTENER_REDIS_SOCKET_TIMEOUT_SECONDS=2
URL_SHORTENER_ANALYTICS_STREAM_NAME=clicks:v1
URL_SHORTENER_ANALYTICS_CONSUMER_GROUP=click-analytics:v1
URL_SHORTENER_ANALYTICS_BATCH_SIZE=100
URL_SHORTENER_ANALYTICS_BLOCK_MS=1000
URL_SHORTENER_ANALYTICS_PENDING_IDLE_MS=60000
URL_SHORTENER_ANALYTICS_STREAM_MAX_LENGTH=100000
URL_SHORTENER_ANALYTICS_LAG_LOG_INTERVAL_SECONDS=60
URL_SHORTENER_ANALYTICS_RETRY_DELAY_SECONDS=1
